[Unit]
Description=FreeDNS Subdomain Rotator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mitch/freedns
ExecStart=/usr/bin/python3 /home/mitch/freedns/web.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
